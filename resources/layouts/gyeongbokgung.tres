[gd_resource type="Resource" script_class="RoomLayout" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/systems/room_layout.gd" id="1_layout"]
[ext_resource type="Script" path="res://scripts/systems/room_def.gd" id="2_def"]

[sub_resource type="Resource" id="Resource_start"]
script = ExtResource("2_def")
room_id = &"start"
room_type = &"start"
scene_path = "res://scenes/session/room_base.tscn"
connections = Array[StringName]([&"combat_1"])
grid_pos = Vector2i(0, 0)

[sub_resource type="Resource" id="Resource_combat_1"]
script = ExtResource("2_def")
room_id = &"combat_1"
room_type = &"combat"
scene_path = "res://scenes/interactables/combat_room.tscn"
connections = Array[StringName]([&"start", &"treasure_1"])
grid_pos = Vector2i(1, 0)
room_config = {
"chaser_count": 2,
"elite_chaser_count": 0,
"elite_ranged_count": 0,
"elite_wolf_count": 0,
"ranged_count": 1,
"wolf_count": 1,
"wave_count": 1
}

[sub_resource type="Resource" id="Resource_treasure_1"]
script = ExtResource("2_def")
room_id = &"treasure_1"
room_type = &"treasure"
scene_path = "res://scenes/interactables/treasure_room.tscn"
connections = Array[StringName]([&"combat_1", &"combat_2"])
grid_pos = Vector2i(2, 0)

[sub_resource type="Resource" id="Resource_combat_2"]
script = ExtResource("2_def")
room_id = &"combat_2"
room_type = &"combat"
scene_path = "res://scenes/interactables/combat_room.tscn"
connections = Array[StringName]([&"treasure_1", &"friend_1"])
grid_pos = Vector2i(3, 0)
room_config = {
"chaser_count": 3,
"elite_chaser_count": 0,
"elite_ranged_count": 0,
"elite_wolf_count": 0,
"ranged_count": 2,
"wolf_count": 1,
"wave_count": 2
}

[sub_resource type="Resource" id="Resource_friend_1"]
script = ExtResource("2_def")
room_id = &"friend_1"
room_type = &"friend"
scene_path = "res://scenes/interactables/friend_room.tscn"
connections = Array[StringName]([&"combat_2", &"final_1"])
grid_pos = Vector2i(4, 0)

[sub_resource type="Resource" id="Resource_final_1"]
script = ExtResource("2_def")
room_id = &"final_1"
room_type = &"final"
scene_path = "res://scenes/interactables/boss_room.tscn"
connections = Array[StringName]([&"friend_1"])
grid_pos = Vector2i(5, 0)

[resource]
script = ExtResource("1_layout")
layout_id = &"gyeongbokgung"
start_room_id = &"start"
room_defs = Array[ExtResource("2_def")]([SubResource("Resource_start"), SubResource("Resource_combat_1"), SubResource("Resource_treasure_1"), SubResource("Resource_combat_2"), SubResource("Resource_friend_1"), SubResource("Resource_final_1")])
